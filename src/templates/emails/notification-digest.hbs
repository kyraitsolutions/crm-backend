<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Notification digest</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding:28px 12px;">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">
          <tr>
            <td style="background:#3b5d50;color:#ffffff;padding:24px 28px;">
              <p style="margin:0 0 6px 0;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.9;">
                {{digestLabel}} digest
              </p>
              <h1 style="margin:0;font-size:22px;line-height:1.3;">
                {{count}} notification{{#unless single}}s{{/unless}}
              </h1>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 18px 0;font-size:14px;color:#4b5563;">Hi {{recipientName}},</p>
              {{#each items}}
              <table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 12px 0;border:1px solid #e5e7eb;border-radius:8px;">
                <tr>
                  <td style="padding:14px 16px;">
                    <p style="margin:0 0 4px 0;font-size:12px;color:#6b7280;text-transform:uppercase;">{{moduleLabel}}</p>
                    <p style="margin:0 0 6px 0;font-size:15px;font-weight:bold;color:#111827;">{{title}}</p>
                    <p style="margin:0;font-size:13px;color:#4b5563;line-height:1.5;">{{body}}</p>
                    {{#if deepLinkUrl}}
                    <p style="margin:10px 0 0 0;">
                      <a href="{{deepLinkUrl}}" style="font-size:13px;color:#3b5d50;font-weight:bold;text-decoration:none;">Open →</a>
                    </p>
                    {{/if}}
                  </td>
                </tr>
              </table>
              {{/each}}
              {{#if settingsUrl}}
              <p style="margin:18px 0 0 0;">
                <a href="{{settingsUrl}}" style="font-size:12px;color:#6b7280;">Manage notification settings</a>
              </p>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td style="padding:16px 28px;background:#f9fafb;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af;">
              © {{year}} Kyra
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
