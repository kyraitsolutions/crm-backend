<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WhatsApp escalation</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding:28px 12px;">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">
          <tr>
            <td style="background:#B45309;color:#ffffff;padding:24px 28px;">
              <p style="margin:0 0 6px 0;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.95;">
                Escalation
              </p>
              <h1 style="margin:0;font-size:22px;line-height:1.3;">
                Human follow-up required
              </h1>
            </td>
          </tr>

          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 16px 0;font-size:15px;color:#374151;line-height:1.6;">
                The WhatsApp AI agent paused this conversation and handed it to your team.
                Please reply from Live Chat as soon as you can.
              </p>

              <table width="100%" cellpadding="0" cellspacing="0" style="background:#fff7ed;border:1px solid #fdba74;border-radius:8px;">
                <tr>
                  <td colspan="2" style="padding:14px 18px;border-bottom:1px solid #fdba74;font-size:14px;font-weight:bold;color:#9a3412;">
                    Why it was escalated
                  </td>
                </tr>
                <tr>
                  <td style="padding:12px 18px;width:140px;font-size:13px;color:#c2410c;">Reason</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">{{reason}}</td>
                </tr>
                {{#if scoreLabel}}
                <tr>
                  <td style="padding:12px 18px;font-size:13px;color:#c2410c;">Lead score</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">{{scoreLabel}}</td>
                </tr>
                {{/if}}
                {{#if intent}}
                <tr>
                  <td style="padding:12px 18px;font-size:13px;color:#c2410c;">Intent</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">{{intent}}</td>
                </tr>
                {{/if}}
              </table>

              <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                <tr>
                  <td colspan="2" style="padding:14px 18px;border-bottom:1px solid #e5e7eb;font-size:14px;font-weight:bold;color:#111827;">
                    Customer
                  </td>
                </tr>
                <tr>
                  <td style="padding:12px 18px;width:140px;font-size:13px;color:#6b7280;">Name</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">{{leadName}}</td>
                </tr>
                {{#if leadPhone}}
                <tr>
                  <td style="padding:12px 18px;font-size:13px;color:#6b7280;">Phone</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">{{leadPhone}}</td>
                </tr>
                {{/if}}
                {{#if leadEmail}}
                <tr>
                  <td style="padding:12px 18px;font-size:13px;color:#6b7280;">Email</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">{{leadEmail}}</td>
                </tr>
                {{/if}}
                <tr>
                  <td style="padding:12px 18px;font-size:13px;color:#6b7280;">Channel</td>
                  <td style="padding:12px 18px;font-size:14px;color:#111827;">WhatsApp</td>
                </tr>
              </table>

              {{#if message}}
              <p style="margin:20px 0 8px 0;font-size:13px;font-weight:bold;color:#111827;">Latest customer message</p>
              <p style="margin:0;padding:14px 16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;font-size:14px;color:#374151;line-height:1.5;">
                {{message}}
              </p>
              {{/if}}

              <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:28px;">
                <tr>
                  <td align="center">
                    {{#if inboxUrl}}
                    <a href="{{inboxUrl}}" style="display:inline-block;background:#B45309;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:8px;font-weight:bold;font-size:14px;">
                      Take over this chat
                    </a>
                    {{/if}}
                    {{#if leadUrl}}
                    <a href="{{leadUrl}}" style="display:inline-block;margin-left:10px;background:#ffffff;color:#B45309;text-decoration:none;padding:12px 22px;border-radius:8px;font-weight:bold;font-size:14px;border:1px solid #B45309;">
                      Open lead
                    </a>
                    {{/if}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 28px;background:#f9fafb;color:#6b7280;font-size:12px;text-align:center;">
              The AI agent will stay paused on this chat until a teammate replies or hands it back.
              <br />© {{year}} Kyra CRM
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
