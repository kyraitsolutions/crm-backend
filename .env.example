# Contact import worker. Copy values into .env / .env.development as needed.

# Worker process concurrency for import:chunk (default 2)
IMPORT_WORKER_CONCURRENCY=2
# Max processing import jobs per organization (default 2)
IMPORT_ORG_ACTIVE_SLOTS=2
# In-flight chunk jobs per import (default 3)
IMPORT_DISPATCH_K=3
# Chunk lease heartbeat interval in ms (default 10000). Lease TTL is 3× this.
IMPORT_HEARTBEAT_MS=10000
# Bull attempts for a chunk job (default 5)
IMPORT_CHUNK_ATTEMPTS=5
# Exponential backoff base in ms (default 2000)
IMPORT_BACKOFF_BASE_MS=2000
# Fail a processing job with no chunk activity after this many ms (default 1800000)
IMPORT_STALL_MAX_MS=1800000
# Sweeper repeat interval in ms (default 60000)
IMPORT_SWEEP_INTERVAL_MS=60000
# Log (do not crash) when Redis maxmemory-policy is not noeviction (default true)
IMPORT_CHECK_REDIS_POLICY=true
# Optional override for XLSX convert temp directory (default os.tmpdir())
IMPORT_XLSX_TEMP_DIR=
# Optional cap on XLSX temp copy bytes (default IMPORT_MAX_XLSX_FILE_BYTES)
IMPORT_XLSX_TEMP_MAX_BYTES=
# Rows per planned chunk (default 1000)
IMPORT_CHUNK_ROWS=1000
# Max bytes per planned chunk (default 2097152)
IMPORT_CHUNK_MAX_BYTES=2097152
# FileStore backend: local | s3 (default local)
IMPORT_FILE_STORE=local
# Root directory for LocalFileStore when IMPORT_FILE_STORE=local
IMPORT_LOCAL_STORE_ROOT=
# Delete source objects this many ms after a terminal job (default 604800000 = 7d)
IMPORT_SOURCE_TTL_MS=604800000
# Delete error reports this many ms after a terminal job (default 2592000000 = 30d)
IMPORT_ERROR_REPORT_TTL_MS=2592000000
# Delete chunk docs this many ms after a terminal job (default 7776000000 = 90d)
IMPORT_CHUNK_RETENTION_MS=7776000000
# Delete abandoned uploaded jobs older than this (default 86400000 = 24h)
IMPORT_ABANDONED_UPLOAD_MS=86400000
# SIGTERM drain window in ms (default 30000)
IMPORT_GRACEFUL_SHUTDOWN_MS=30000

# XLSX streaming converter (defaults target 500k rows / 250 MB)
# Reject XLSX larger than this many bytes (default 262144000 = 250 MB)
IMPORT_MAX_XLSX_FILE_BYTES=262144000
# Reject XLSX with more than this many non-empty rows (default 500000)
IMPORT_MAX_XLSX_ROWS=500000
# Reject XLSX with more than this many columns (default 64)
IMPORT_MAX_COLUMNS=64
# Zip-bomb: total uncompressed bytes across entries (default 419430400 = 400 MB)
IMPORT_MAX_XLSX_UNCOMPRESSED=419430400
# Zip-bomb: max uncompressed/compressed ratio, declared and actual (default 100)
IMPORT_MAX_XLSX_RATIO=100
# Zip-bomb: max zip entries (default 64)
IMPORT_MAX_XLSX_ENTRIES=64
# Zip-bomb: max uncompressed bytes for a single entry (default 262144000 = 250 MB)
IMPORT_MAX_XLSX_ENTRY_BYTES=262144000
# Shared strings table byte cap (default 33554432 = 32 MB). Over = upload CSV.
IMPORT_MAX_SHARED_STRINGS_BYTES=33554432

# HTTP API
# Max non-terminal import jobs per account (default 2)
IMPORT_MAX_ACTIVE_PER_ACCOUNT=2
# Max import job creations per account per hour (default 20)
IMPORT_MAX_CREATES_PER_HOUR=20
# Max dry-runs per import job per hour (default 30)
IMPORT_MAX_DRY_RUNS_PER_HOUR=30
# Optional antivirus hook after complete-upload (default off; NoopScanner)
IMPORT_AV_SCAN_ENABLED=0
# SSE heartbeat / poll / per-user connection cap
IMPORT_SSE_HEARTBEAT_MS=15000
IMPORT_SSE_POLL_MS=1000
IMPORT_SSE_MAX_CONNECTIONS_PER_USER=4
